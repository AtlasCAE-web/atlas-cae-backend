# ── Servidor ──────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── CORS — separar múltiples orígenes con coma ────────────
# Soporta wildcards: https://*.vercel.app
ALLOWED_ORIGINS=https://atlascae.es,https://TU-PROYECTO.vercel.app

# ── Email (Resend) ────────────────────────────────────────
# Consigue tu API key en: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remitente — debe ser un dominio verificado en Resend
# Para pruebas sin verificar dominio usa: Atlas CAE <onboarding@resend.dev>
EMAIL_FROM=Atlas CAE <onboarding@resend.dev>

# Destinatario interno (equipo ATLAS CAE)
EMAIL_TO=equipo@atlascae.es
